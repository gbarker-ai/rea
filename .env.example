# Google Cloud & Vertex AI Configuration (Injected via Secret Manager in Production)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Secret Manager Secret IDs (No hardcoded API keys!)
GEMINI_API_KEY_SECRET_ID=real-estate-agent-gemini-api-key
BROKER_HITL_SIGNING_SECRET_ID=real-estate-agent-broker-hitl-secret
MLS_API_TOKEN_SECRET_ID=real-estate-agent-mls-api-token

# Local Development Overrides (Optional - fetched via SecretManagerVault if unset)
REAL_ESTATE_STORAGE_BACKEND=sqlite
REAL_ESTATE_DB_PATH=/tmp/real_estate_front_desk_memory.db
OTEL_SERVICE_NAME=real-estate-front-desk-agent
LOG_LEVEL=INFO
